{
	"name": "warfeous-site",
	"compatibility_date": "2026-05-31",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"routes": [
		{ "pattern": "warfeous.com", "custom_domain": true },
		{ "pattern": "www.warfeous.com", "custom_domain": true }
	],
	"assets": {
		"directory": "./dist",
		"html_handling": "drop-trailing-slash"
	},
	"observability": {
		"enabled": true
	},
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "95fb9898643244018efee1f998eed654"
		}
	]
}