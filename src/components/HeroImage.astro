---
import Img from './Img.astro';

interface Props {
  src: string;
  alt: string;
  caption?: string;
  bleed?: boolean;
}

const { src, alt, caption, bleed = false } = Astro.props;
---
<figure class:list={['w-hero', { 'w-hero--bleed': bleed }]}>
  <div class="w-hero__img">
    <Img src={src} alt={alt} loading="eager" fetchpriority="high" sizes={bleed ? '100vw' : '(min-width: 800px) 760px, 100vw'} />
    <div class="w-hero__grain"></div>
  </div>
  {caption && <figcaption class="w-hero__caption">{caption}</figcaption>}
</figure>
