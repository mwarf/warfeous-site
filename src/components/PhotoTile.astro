---
import { TONES, formatDate } from '../lib/utils';

interface Props {
  slug: string;
  title: string;
  publishedAt: Date;
  location?: string;
  tone?: string;
}

const { slug, title, publishedAt, location, tone = 'glacier' } = Astro.props;
const dateStr = formatDate(publishedAt);
---
<a href={`/journal/${slug}`} class="w-tile">
  <div class="w-tile__img" style={`background: ${TONES[tone]}`}>
    <div class="w-tile__grain"></div>
  </div>
  <div class="w-tile__caption">{dateStr}{location ? ` · ${location}` : ''}</div>
  <p class="w-tile__title">{title}</p>
</a>
