---
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="About">
  <Masthead slot="masthead" />
  <Footer slot="footer" />

  <div class="w-page w-about">
    <p class="w-eyebrow">About</p>
    <h1 class="w-pagetitle w-about__title">Michael Warf</h1>

    <p class="w-about__lede">
      Documentary filmmaker and photographer in Lethbridge, on the Oldman River in Treaty 7 territory, Southern Alberta.
    </p>

    <p class="w-prose">
      I make non-fiction work for clients in agriculture, conservation, and regional tourism. The studio is <a href="https://coalbanks.com">Coalbanks Creative</a>. The journal is where the unfinished thinking lives: notes from the cut, photo essays from the field, longer pieces when something earns the length.
    </p>
    <p class="w-prose">
      This is not a CV. For project work, the studio site is the right address. For anything else, write me at <a href="mailto:michael@coalbanks.com">michael@coalbanks.com</a>.
    </p>
  </div>
</BaseLayout>

<style>
  .w-about { max-width: 680px; }
  .w-about__title { margin-bottom: 32px; }
  .w-about__lede {
    font-family: var(--w-font-body);
    font-size: 22px;
    font-variation-settings: "opsz" 36, "wght" 380;
    line-height: 1.42;
    letter-spacing: -0.005em;
    color: var(--w-ink-soft);
    margin: 0 0 36px;
    max-width: 52ch;
    text-wrap: pretty;
  }
  .w-about .w-prose { margin: 0 0 1.15em; }
</style>
