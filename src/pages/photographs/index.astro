---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Masthead from '../../components/Masthead.astro';
import Footer from '../../components/Footer.astro';
import PhotoTile from '../../components/PhotoTile.astro';
import { getCollection, getEntry } from 'astro:content';

const allEntries = await getCollection('journal', ({ data }) => !data.draft && data.type === 'photo-essay');
allEntries.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const tiles = await Promise.all(
  allEntries.map(async entry => {
    let image: { src: string; alt: string } | undefined;
    if (entry.data.gallery) {
      const g = await getEntry('galleries', entry.data.gallery.id);
      const first = g?.data.images[0];
      if (first) image = { src: first.src, alt: first.alt };
    }
    return { entry, image };
  })
);
---
<BaseLayout title="Photographs" photo>
  <Masthead slot="masthead" />
  <Footer slot="footer" />

  <div class="w-page w-page--photo">
    <h1 class="w-pagetitle">Photographs</h1>

    {tiles.length > 0 ? (
      <div class="w-pgrid w-pgrid--photographs">
        {tiles.map(({ entry, image }) => (
          <PhotoTile
            slug={entry.id}
            title={entry.data.title}
            publishedAt={entry.data.publishedAt}
            location={entry.data.location}
            image={image}
          />
        ))}
      </div>
    ) : (
      <p class="w-prose">Nothing here yet. The photo essays go up once I've readied the images. The writing lives in the <a href="/journal">journal</a>.</p>
    )}
  </div>
</BaseLayout>
