---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Masthead from '../../components/Masthead.astro';
import Footer from '../../components/Footer.astro';
import PhotoTile from '../../components/PhotoTile.astro';
import { getCollection } from 'astro:content';

const allEntries = await getCollection('journal', ({ data }) => !data.draft && data.type === 'photo-essay');
allEntries.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---
<BaseLayout title="Photographs">
  <Masthead slot="masthead" route="/photographs" />
  <Footer slot="footer" />

  <div class="w-page w-page--photo">
    <h1 style={{
      fontFamily: 'var(--w-font-display)',
      fontSize: 'clamp(40px, 4vw + 16px, 60px)',
      fontWeight: 400,
      letterSpacing: '-0.034em',
      color: 'var(--w-ink-soft)',
      margin: '0 0 48px',
      fontVariationSettings: '"opsz" 144, "wght" 420, "SOFT" 50',
      lineHeight: 0.95,
    }}>Photographs</h1>

    <div class="w-pgrid w-pgrid--photographs">
      {allEntries.map(entry => (
        <PhotoTile
          slug={entry.id}
          title={entry.data.title}
          publishedAt={entry.data.publishedAt}
          location={entry.data.location}
        />
      ))}
    </div>
  </div>
</BaseLayout>
