---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Masthead from '../../components/Masthead.astro';
import Footer from '../../components/Footer.astro';
import EntryRow from '../../components/EntryRow.astro';
import MonthGroup from '../../components/MonthGroup.astro';
import { getCollection } from 'astro:content';
import { groupEntriesByMonth } from '../../lib/utils';

const allEntries = await getCollection('journal', ({ data }) => !data.draft);
allEntries.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const groups = groupEntriesByMonth(allEntries);
---
<BaseLayout title="Journal">
  <Masthead slot="masthead" />
  <Footer slot="footer" />

  <div class="w-page">
    <h1 class="w-pagetitle">Journal</h1>

    <section>
      {groups.map(group => (
        <>
          <MonthGroup label={group.label} />
          {group.entries.map(entry => (
            <EntryRow
              slug={entry.id}
              title={entry.data.title}
              type={entry.data.type}
              publishedAt={entry.data.publishedAt}
              excerpt={entry.data.excerpt}
              location={entry.data.location}
            />
          ))}
        </>
      ))}
    </section>
  </div>
</BaseLayout>
