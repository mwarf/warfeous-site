---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Masthead from '../../components/Masthead.astro';
import Footer from '../../components/Footer.astro';
import EntryRow from '../../components/EntryRow.astro';
import MonthGroup from '../../components/MonthGroup.astro';
import { getCollection } from 'astro:content';
import { groupEntriesByMonth } from '../../lib/utils';

const allEntries = await getCollection('journal', ({ data }) => !data.draft);
allEntries.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const groups = groupEntriesByMonth(allEntries);
---
<BaseLayout title="Journal" article>
  <Masthead slot="masthead" route="/journal" />
  <Footer slot="footer" />

  <div class="w-page">
    <h1 style={{
      fontFamily: 'var(--w-font-display)',
      fontSize: 'clamp(40px, 4vw + 16px, 60px)',
      fontWeight: 400,
      letterSpacing: '-0.034em',
      color: 'var(--w-ink-soft)',
      margin: '0 0 48px',
      fontVariationSettings: '"opsz" 144, "wght" 420, "SOFT" 50',
      lineHeight: 0.95,
    }}>Journal</h1>

    <section>
      {groups.map(group => (
        <>
          <MonthGroup label={group.label} />
          {group.entries.map(entry => (
            <EntryRow
              slug={entry.id}
              title={entry.data.title}
              type={entry.data.type}
              publishedAt={entry.data.publishedAt}
              excerpt={entry.data.excerpt}
              location={entry.data.location}
            />
          ))}
        </>
      ))}
    </section>
  </div>
</BaseLayout>
