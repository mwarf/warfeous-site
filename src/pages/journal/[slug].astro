---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Masthead from '../../components/Masthead.astro';
import Footer from '../../components/Footer.astro';
import EntryMeta from '../../components/EntryMeta.astro';
import HeroImage from '../../components/HeroImage.astro';
import PrevNext from '../../components/PrevNext.astro';
import ShareRow from '../../components/ShareRow.astro';
import Gallery from '../../components/Gallery.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { formatDate, readingTime } from '../../lib/utils';

export async function getStaticPaths() {
  const entries = await getCollection('journal', ({ data }) => import.meta.env.DEV || !data.draft);
  const sorted = entries.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

  return sorted.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: i > 0 ? { slug: sorted[i - 1].id, title: sorted[i - 1].data.title } : null,
      next: i < sorted.length - 1 ? { slug: sorted[i + 1].id, title: sorted[i + 1].data.title } : null,
    },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const slug = entry.id;
const { title, type, publishedAt, location, excerpt, hero, gallery, dropcap } = entry.data;
const isNote = type === 'note';
const isPhotoEssay = type === 'photo-essay';
const isEssay = type === 'essay';
const noDropcap = isEssay && dropcap === false;

let galleryImages: { src: string; alt: string; caption?: string; width: number; height: number }[] = [];
if (isPhotoEssay && gallery) {
  const galleryEntry = await getEntry('galleries', gallery.id);
  galleryImages = galleryEntry?.data.images ?? [];
}

const mins = readingTime(entry.body || '');

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': isPhotoEssay ? 'ImageGallery' : 'Article',
  ...(isPhotoEssay
    ? {
        name: title,
        datePublished: publishedAt.toISOString(),
      }
    : {
        headline: title,
        datePublished: publishedAt.toISOString(),
        dateModified: (entry.data.updatedAt || publishedAt).toISOString(),
        author: { '@type': 'Person', name: 'Michael Warf' },
        description: excerpt || '',
      }
  ),
});
---
<BaseLayout
  title={title}
  description={excerpt}
  canonicalUrl={entry.data.canonicalUrl}
  ogImage={new URL(`/og/${entry.id}.png`, Astro.site).toString()}
  article
  wide={isPhotoEssay}
  jsonLd={jsonLd}
>
  <Masthead slot="masthead" />
  <Footer slot="footer" />

  <article class:list={['w-article', 'w-page', { 'w-article--essay': isEssay, 'w-article--note': isNote, 'w-article--pe': isPhotoEssay, 'w-article--no-dropcap': noDropcap }]} data-type={type}>
    <header>
      <EntryMeta
        type={type}
        publishedAt={publishedAt}
        location={location}
        readingMins={isEssay ? mins : undefined}
        slug={entry.id}
      />
      <h1 class="w-article__title">{title}</h1>
      {!isNote && excerpt && (
        <p class="w-article__lead">{excerpt}</p>
      )}
    </header>

    {!isNote && !isPhotoEssay && hero && (
      <HeroImage src={hero.src} alt={hero.alt} caption={hero.caption || `${location ? `${location} · ` : ''}${formatDate(publishedAt)}`} />
    )}

    {isPhotoEssay && galleryImages.length > 0 && (
      <Gallery images={galleryImages} />
    )}

    <Content />

    {!isPhotoEssay && <ShareRow />}

    <PrevNext prev={prev} next={next} />
  </article>
</BaseLayout>
