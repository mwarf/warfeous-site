---
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="404 · Page not found">
  <Masthead slot="masthead" />
  <Footer slot="footer" />

  <div class="w-page w-404">
    <p class="w-eyebrow">404 · page not found</p>
    <h1 class="w-pagetitle w-pagetitle--404">Nothing here.</h1>
    <p class="w-404__line">
      The page you were after has either moved, never existed, or fell off the edit-room floor.
    </p>
    <p class="w-404__back">
      <a href="/">← Back to the front page</a>
    </p>
  </div>
</BaseLayout>

<style>
  .w-404 {
    max-width: 620px;
    padding-top: 64px;
  }
  .w-404__line {
    font-family: var(--w-font-body);
    font-size: 19px;
    line-height: 1.55;
    color: var(--w-ink);
    max-width: 50ch;
  }
  .w-404__back {
    font-family: var(--w-font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--w-sage);
    margin-top: 32px;
  }
</style>
