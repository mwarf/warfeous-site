---
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';
import EntryRow from '../components/EntryRow.astro';
import EntryMeta from '../components/EntryMeta.astro';
import MonthGroup from '../components/MonthGroup.astro';
import PhotoTile from '../components/PhotoTile.astro';
import { getCollection, getEntry } from 'astro:content';
import { groupEntriesByMonth } from '../lib/utils';

const allEntries = await getCollection('journal', ({ data }) => !data.draft);
allEntries.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const featured = allEntries.find(e => e.data.type === 'essay') || allEntries[0];
const featuredIndex = featured ? allEntries.indexOf(featured) : -1;
const dense = featured ? allEntries.filter((_, i) => i !== featuredIndex).slice(0, 5) : allEntries.slice(0, 5);
const denseGroups = groupEntriesByMonth(dense);
const latestPhoto = allEntries.find(e => e.data.type === 'photo-essay');

let latestPhotoImage: { src: string; alt: string } | undefined;
if (latestPhoto?.data.gallery) {
  const g = await getEntry('galleries', latestPhoto.data.gallery.id);
  const first = g?.data.images[0];
  if (first) latestPhotoImage = { src: first.src, alt: first.alt };
}
---
<BaseLayout title="warfeous">
  <Masthead slot="masthead" />
  <Footer slot="footer" />

  <div class="w-page">
    {featured && (
    <section class="w-home__featured">
      <div class="w-eyebrow">Latest essay</div>
      <a href={`/journal/${featured.id}`} class="w-home__featured-link">
        <h1 class="w-pagetitle w-pagetitle--home">{featured.data.title}</h1>
        {featured.data.excerpt && (
          <p class="w-lead">{featured.data.excerpt}</p>
        )}
        <EntryMeta
          type={featured.data.type}
          publishedAt={featured.data.publishedAt}
          location={featured.data.location}
          slug={featured.id}
        />
      </a>
    </section>
    )}

    <section class="w-home__dense">
      {denseGroups.map(group => (
        <>
          <MonthGroup label={group.label} />
          {group.entries.map(entry => (
            <EntryRow
              slug={entry.id}
              title={entry.data.title}
              type={entry.data.type}
              publishedAt={entry.data.publishedAt}
              excerpt={entry.data.excerpt}
              location={entry.data.location}
            />
          ))}
        </>
      ))}
      <a class="w-more" href="/journal">All entries →</a>
    </section>

    {latestPhoto && (
      <section class="w-home__photo">
        <div class="w-eyebrow">Latest photo essay</div>
        <PhotoTile
          slug={latestPhoto.id}
          title={latestPhoto.data.title}
          publishedAt={latestPhoto.data.publishedAt}
          location={latestPhoto.data.location}
          image={latestPhotoImage}
        />
        <a class="w-more" href="/photographs">All photographs →</a>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .w-home__featured { padding-bottom: 28px; }
  .w-home__featured-link {
    display: block;
    text-decoration: none;
    color: inherit;
    border: 0;
  }
  .w-home__dense { margin-top: 32px; }
  .w-home__photo { margin-top: 64px; }
</style>
