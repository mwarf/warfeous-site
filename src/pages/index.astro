---
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';
import EntryRow from '../components/EntryRow.astro';
import EntryMeta from '../components/EntryMeta.astro';
import MonthGroup from '../components/MonthGroup.astro';
import PhotoTile from '../components/PhotoTile.astro';
import { getCollection } from 'astro:content';
import { groupEntriesByMonth } from '../lib/utils';

const allEntries = await getCollection('journal', ({ data }) => !data.draft);
allEntries.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const featured = allEntries.find(e => e.data.type === 'essay') || allEntries[0];
const featuredIndex = featured ? allEntries.indexOf(featured) : -1;
const dense = featured ? allEntries.filter((_, i) => i !== featuredIndex).slice(0, 5) : allEntries.slice(0, 5);
const denseGroups = groupEntriesByMonth(dense);
const latestPhoto = allEntries.find(e => e.data.type === 'photo-essay');
---
<BaseLayout title={featured ? featured.data.title : 'warfeous'} article>
  <Masthead slot="masthead" route="/" />
  <Footer slot="footer" />

  <div class="w-page">
    {featured && (
    <section style="padding-bottom: 28px; margin-bottom: 0;">
      <div class="w-eyebrow">Latest essay</div>
      <a href={`/journal/${featured.id}`} style="display: block; text-decoration: none; color: inherit; border: 0;">
        <h1 style={{
          fontFamily: 'var(--w-font-display)',
          fontSize: 'clamp(48px, 6vw + 16px, 88px)',
          fontWeight: 400,
          letterSpacing: '-0.038em',
          fontVariationSettings: '"opsz" 144, "wght" 420, "SOFT" 50',
          color: 'var(--w-ink-soft)',
          margin: '0 0 18px',
          lineHeight: 0.94,
          textWrap: 'balance',
        }}>{featured.data.title}</h1>
        {featured.data.excerpt && (
          <p class="w-lead" style="font-size: 21px; margin: 0 0 16px;">{featured.data.excerpt}</p>
        )}
        <EntryMeta
          type={featured.data.type}
          publishedAt={featured.data.publishedAt}
          location={featured.data.location}
          slug={featured.id}
        />
      </a>
    </section>
    )}

    <section style="margin-top: 32px;">
      {denseGroups.map(group => (
        <>
          <MonthGroup label={group.label} />
          {group.entries.map(entry => (
            <EntryRow
              slug={entry.id}
              title={entry.data.title}
              type={entry.data.type}
              publishedAt={entry.data.publishedAt}
              excerpt={entry.data.excerpt}
              location={entry.data.location}
            />
          ))}
        </>
      ))}
    </section>

    {latestPhoto && (
      <section style="margin-top: 64px;">
        <div class="w-eyebrow">Latest photo essay</div>
        <PhotoTile
          slug={latestPhoto.id}
          title={latestPhoto.data.title}
          publishedAt={latestPhoto.data.publishedAt}
          location={latestPhoto.data.location}
        />
      </section>
    )}
  </div>
</BaseLayout>
