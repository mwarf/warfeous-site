---
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';

const sections = [
  {
    heading: 'Build',
    body: 'Astro on Cloudflare Workers. MDX for entries. Content collections enforce a single schema across essays, notes, and photo essays. No CMS, no admin. Markdown in, site out.',
  },
  {
    heading: 'Typefaces',
    terms: [
      { term: 'Display', def: 'Fraunces, variable, opsz 144 at title sizes' },
      { term: 'Body', def: 'Newsreader, designed for screen reading at 17–19px' },
      { term: 'Mono', def: 'iA Writer Mono S, for metadata, dates, and captions' },
    ],
  },
  {
    heading: 'Photography',
    body: 'Stills are made with a Nikon Zf and a mix of native glass and adapted vintage lenses. I also shoot 35mm and 120 film. Video is shot on a Nikon ZR using the RED colour profile. Stills are delivered through Cloudflare Images and video through Cloudflare Stream.',
  },
  {
    heading: 'Editing',
    body: 'DaVinci Resolve for grade, Pro Tools for sound, Lightroom for stills. The grain pass is intentional and stays in the export.',
  },
];
---
<BaseLayout title="Colophon">
  <Masthead slot="masthead" />
  <Footer slot="footer" />

  <div class="w-page w-colophon">
    <p class="w-eyebrow">Colophon</p>
    <h1 class="w-pagetitle w-colophon__title">How this site is made</h1>

    {sections.map((section, i) => (
      <section class="w-colophon__section">
        <div class="w-colophon__num">{String(i + 1).padStart(2, '0')}</div>
        <h2>{section.heading}</h2>
        <div class="w-prose">
          {section.body}
          {section.terms && (
            <dl>
              {section.terms.map(t => (
                <>
                  <dt>{t.term}</dt>
                  <dd>{t.def}</dd>
                </>
              ))}
            </dl>
          )}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .w-colophon { max-width: 680px; }
  .w-colophon__title { margin-bottom: 24px; }
  .w-colophon__section {
    padding: 32px 0;
    border-top: 1px solid var(--w-rule);
  }
  .w-colophon__section h2 { margin-top: 0; }
  .w-colophon__num {
    font-family: var(--w-font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--w-sage);
    margin-bottom: 8px;
    font-feature-settings: "tnum", "lnum";
  }
  .w-colophon dl {
    display: grid;
    grid-template-columns: 6em 1fr;
    gap: 8px 16px;
    margin: 4px 0 0;
  }
  .w-colophon dt {
    font-family: var(--w-font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--w-sage);
    padding-top: 0.3em;
  }
  .w-colophon dd {
    margin: 0;
  }
</style>
