# Public Cloudflare Images account hash (dashboard > Images > account hash).
# Used at build time to turn Image IDs into imagedelivery.net URLs.
PUBLIC_CF_IMAGES_HASH=

# Secrets for scripts/cf-upload.mjs only — never used by the site, never commit
# a filled-in copy of this file.
# Cloudflare dashboard, right sidebar:
CLOUDFLARE_ACCOUNT_ID=
# API token with the Cloudflare Images:Edit permission:
CLOUDFLARE_IMAGES_TOKEN=
